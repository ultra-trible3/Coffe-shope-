// Prisma schema — Qahwa Coffee House POS & Management System
// Target: PostgreSQL 14+ (NUMERIC for money, strict FKs, indexes).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
  KITCHEN_STAFF
}

enum MenuKind {
  HOT_DRINK
  COLD_DRINK
  BAKERY
  DESSERT
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum IngredientUnit {
  KG
  G
  L
  ML
  PIECE
  PACK
}

enum MovementType {
  PURCHASE
  SALE_DEDUCTION
  ADJUSTMENT
  WASTE
  RETURN
  CANCELLATION_RETURN
}

enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  email               String?   @unique
  fullName            String
  passwordHash        String
  role                Role      @default(CASHIER)
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions           Session[]
  auditLogs          AuditLog[]
  orders             Order[]             @relation("OrderCashier")
  inventoryMovements InventoryMovement[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  terminalId String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  terminalId String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Menu
// ---------------------------------------------------------------------------

model Category {
  id            String   @id @default(cuid())
  name          String   @unique
  nameAr        String?
  description   String?
  descriptionAr String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items MenuItem[]

  @@index([sortOrder])
  @@map("categories")
}

model MenuItem {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  imageUrl      String?
  categoryId    String
  kind          MenuKind @default(HOT_DRINK)
  basePrice     Decimal  @db.Decimal(14, 2)
  costPrice     Decimal  @default(0) @db.Decimal(14, 2)
  prepMinutes   Int      @default(15)
  isAvailable   Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  hasSizes      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sizes      MenuItemSize[]
  recipe     Recipe?
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([kind])
  @@index([isAvailable])
  @@index([isFeatured])
  @@index([name])
  @@map("menu_items")
}

model MenuItemSize {
  id                   String  @id @default(cuid())
  menuItemId           String
  name                 String
  nameAr               String?
  price                Decimal @db.Decimal(14, 2)
  ingredientMultiplier Decimal @default(1) @db.Decimal(6, 3)
  isDefault            Boolean @default(false)
  sortOrder            Int     @default(0)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, name])
  @@index([menuItemId])
  @@map("menu_item_sizes")
}

model Topping {
  id                 String   @id @default(cuid())
  name               String   @unique
  nameAr             String?
  price              Decimal  @db.Decimal(14, 2)
  ingredientId       String?
  ingredientQuantity Decimal  @default(0) @db.Decimal(12, 3)
  isAvailable        Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  ingredient        Ingredient?        @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  orderItemToppings OrderItemTopping[]

  @@index([isAvailable])
  @@index([sortOrder])
  @@map("toppings")
}

// ---------------------------------------------------------------------------
// Inventory & recipes
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients Ingredient[]

  @@index([name])
  @@map("suppliers")
}

model Ingredient {
  id           String         @id @default(cuid())
  sku          String         @unique
  name         String
  nameAr       String?
  unit         IngredientUnit
  currentStock Decimal        @default(0) @db.Decimal(12, 3)
  minStock     Decimal        @default(0) @db.Decimal(12, 3)
  costPerUnit  Decimal        @default(0) @db.Decimal(12, 2)
  supplierId   String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements   InventoryMovement[]
  recipeItems RecipeItem[]
  toppings    Topping[]

  @@index([name])
  @@index([isActive])
  @@index([supplierId])
  @@map("ingredients")
}

model Recipe {
  id         String   @id @default(cuid())
  menuItemId String   @unique
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  items    RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Decimal @db.Decimal(12, 3)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_items")
}

model InventoryMovement {
  id           String       @id @default(cuid())
  ingredientId String
  orderId      String?
  type         MovementType
  quantity     Decimal      @db.Decimal(12, 3)
  unitCost     Decimal?     @db.Decimal(12, 2)
  reference    String?
  note         String?
  userId       String?
  createdAt    DateTime     @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ingredientId, createdAt])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Discount {
  id        String       @id @default(cuid())
  name      String
  nameAr    String?
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orders Order[]

  @@index([isActive])
  @@map("discounts")
}

// ---------------------------------------------------------------------------
// Orders, payments & invoices
// ---------------------------------------------------------------------------

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  type              OrderType
  status            OrderStatus   @default(PENDING)
  customerId        String?
  customerName      String?
  customerPhone     String?
  customerAddress   String?
  tableNumber       String?
  cashierId         String
  subtotal          Decimal       @db.Decimal(14, 2)
  discount          Decimal       @default(0) @db.Decimal(14, 2)
  discountLabel     String?
  discountLabelAr   String?
  discountId        String?
  tax               Decimal       @default(0) @db.Decimal(14, 2)
  deliveryFee       Decimal       @default(0) @db.Decimal(14, 2)
  total             Decimal       @db.Decimal(14, 2)
  amountPaid        Decimal       @default(0) @db.Decimal(14, 2)
  changeDue         Decimal       @default(0) @db.Decimal(14, 2)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PAID)
  notes             String?
  inventoryDeducted Boolean       @default(false)
  inventoryRestored Boolean       @default(false)
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountRel        Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  cashier            User                @relation("OrderCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  payments           Payment[]
  invoice            Invoice?
  inventoryMovements InventoryMovement[]

  @@index([orderNumber])
  @@index([status, createdAt])
  @@index([type])
  @@index([cashierId])
  @@index([customerId])
  @@index([createdAt])
  @@index([paymentMethod])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  menuItemId          String
  menuItemName        String
  menuItemNameAr      String?
  imageUrl            String?
  sizeId              String?
  sizeName            String?
  sizeNameAr          String?
  quantity            Int
  unitPrice           Decimal  @db.Decimal(14, 2)
  toppingsTotal       Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal           Decimal  @db.Decimal(14, 2)
  unitCost            Decimal  @default(0) @db.Decimal(14, 2)
  specialInstructions String?
  createdAt           DateTime @default(now())

  order    Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  toppings OrderItemTopping[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderItemTopping {
  id          String  @id @default(cuid())
  orderItemId String
  toppingId   String?
  name        String
  nameAr      String?
  price       Decimal @db.Decimal(14, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  topping   Topping?  @relation(fields: [toppingId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([toppingId])
  @@map("order_item_toppings")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  reference String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([method])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String   @unique
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([issuedAt])
  @@map("invoices")
}

model RestaurantSettings {
  id                    String   @id @default("default")
  name                  String   @default("Qahwa Coffee House")
  nameAr                String?
  tagline               String?
  taglineAr             String?
  address               String?
  addressAr             String?
  phone                 String?
  email                 String?
  taxRate               Decimal  @default(14) @db.Decimal(5, 2)
  deliveryFee           Decimal  @default(25) @db.Decimal(14, 2)
  maxCashierDiscountPct Decimal  @default(20) @db.Decimal(5, 2)
  receiptFooter         String?
  receiptFooterAr       String?
  currency              String   @default("EGP")
  updatedAt             DateTime @updatedAt

  @@map("restaurant_settings")
}
